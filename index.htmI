<!DOCTYPE html>
<html lang="ku" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Oil Company System</title>

<style>
*{box-sizing:border-box}

body{
margin:0;
font-family:Arial,Tahoma,sans-serif;
background:#f4f7fb;
color:#172033;
}

header{
background:#0b1f33;
color:white;
padding:16px;
display:flex;
justify-content:space-between;
align-items:center;
}

header h1{
font-size:20px;
margin:0;
}

button{
border:0;
border-radius:10px;
padding:11px 16px;
cursor:pointer;
font-weight:bold;
}

.lang{
background:white;
color:#123;
}

.container{
max-width:1100px;
margin:auto;
padding:20px;
}

.login{
max-width:400px;
margin:80px auto;
background:white;
padding:30px;
border-radius:18px;
box-shadow:0 5px 25px #0002;
}

.login h2{
text-align:center;
}

input,select{
width:100%;
padding:12px;
border:1px solid #d4dee8;
border-radius:10px;
margin:7px 0 14px;
font-size:15px;
}

.primary{
background:#0c7658;
color:white;
width:100%;
}

.logout{
background:#c93c3c;
color:white;
}

.hero{
background:linear-gradient(135
