<!DOCTYPE html>
<html lang="ku" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Oil Company System</title>

<style>
*{
  box-sizing:border-box;
}

body{
  margin:0;
  font-family:Arial,Tahoma,sans-serif;
  background:#f3f6f8;
  color:#17212b;
}

header{
  background:#092033;
  color:white;
  padding:20px;
  text-align:center;
}

header h1{
  margin:0 0 8px;
  font-size:28px;
}

header p{
  margin:0;
  opacity:.8;
}

.container{
  max-width:1100px;
  margin:auto;
  padding:20px;
}

.cards{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:15px;
  margin-bottom:20px;
}

.card{
  background:white;
  padding:20px;
  border-radius:14px;
  box-shadow:0 3px 12px #0001;
  text-align:center;
}

.card h2{
  margin:5px 0;
  color:#092033;
}

.card p{
  margin:0;
  color:#777;
}

.panel{
  background:white;
  padding:20px;
  border-radius:14px;
  box-shadow:0 3px 12px #0001;
  margin-bottom:20px;
}

.panel h2{
  margin-top:0;
  color:#092033;
}

form{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:12px;
}

input,select,button{
  width:100%;
  padding:13px;
  border-radius:9px;
  border:1px solid #ddd;
  font-size:16px;
}

button{
  background:#092033;
  color:white;
  border:0;
  cursor:pointer;
}

button:hover{
  background:#123b5a;
}

table{
  width:100%;
  border-collapse:collapse;
  margin-top:15px;
}

th,td{
  padding:12px;
  border-bottom:1px solid #eee;
  text-align:center;
}

th{
  background:#092033;
  color:white;
}

.delete{
  background:#c62828;
  padding:8px;
}

@media(max-width:700px){
  .cards{
    grid-template-columns:repeat(2,1fr);
  }

  form{
    grid-template-columns:1fr;
  }

  table{
    font-size:13px;
  }

  .container{
    padding:12px;
  }
}
</style>
</head>

<body>

<header>
  <h1>🏢 سیستەمی کۆمپانیای نەوت</h1>
  <p>Oil Company Management System</p>
</header>

<div class="container">

  <div class="cards">
    <div class="card">
      <h2 id="totalEmployees">0</h2>
      <p>کارمەندان</p>
    </div>

    <div class="card">
      <h2 id="totalVehicles">0</h2>
      <p>ئۆتۆمبێلەکان</p>
    </div>

    <div class="card">
      <h2 id="totalFuel">0</h2>
      <p>کۆی لیتر</p>
    </div>

    <div class="card">
      <h2 id="totalRecords">0</h2>
      <p>تۆمارەکان</p>
    </div>
  </div>

  <div class="panel">
    <h2>➕ زیادکردنی تۆمار</h2>

    <form id="recordForm">

      <input
        type="text"
        id="name"
        placeholder="ناوی کارمەند"
        required
      >

      <input
        type="text"
        id="vehicle"
        placeholder="ژمارەی ئۆتۆمبێل"
        required
      >

      <input
        type="number"
        id="fuel"
        placeholder="بڕی نەوت بە لیتر"
        min="0"
        required
      >

      <select id="type">
        <option value="Diesel">Diesel</option>
        <option value="Petrol">Petrol</option>
        <option value="Oil">Oil</option>
      </select>

      <button type="submit">
        زیادکردنی تۆمار
      </button>

    </form>
  </div>

  <div class="panel">
    <h2>📋 لیستی تۆمارەکان</h2>

    <table>
      <thead>
        <tr>
          <th>ناو</th>
          <th>ئۆتۆمبێل</th>
          <th>جۆر</th>
          <th>لیتر</th>
          <th>کردار</th>
        </tr>
      </thead>

      <tbody id="records"></tbody>
    </table>
  </div>

</div>

<script>

let records = JSON.parse(
  localStorage.getItem("oilRecords") || "[]"
);

function save(){
  localStorage.setItem(
    "oilRecords",
    JSON.stringify(records)
  );
}

function display(){

  const table = document.getElementById("records");

  table.innerHTML = "";

  let fuel = 0;
  let vehicles = new Set();

  records.forEach((record,index)=>{

    fuel += Number(record.fuel);
    vehicles.add(record.vehicle);

    table.innerHTML += `
      <tr>
        <td>${record.name}</td>
        <td>${record.vehicle}</td>
        <td>${record.type}</td>
        <td>${record.fuel}</td>
        <td>
          <button
            class="delete"
            onclick="deleteRecord(${index})">
            سڕینەوە
          </button>
        </td>
      </tr>
    `;
  });

  document.getElementById("totalEmployees").textContent =
    new Set(records.map(x=>x.name)).size;

  document.getElementById("totalVehicles").textContent =
    vehicles.size;

  document.getElementById("totalFuel").textContent =
    fuel;

  document.getElementById("totalRecords").textContent =
    records.length;
}

document.getElementById("recordForm").addEventListener(
  "submit",
  function(e){

    e.preventDefault();

    records.push({
      name:document.getElementById("name").value,
      vehicle:document.getElementById("vehicle").value,
      fuel:document.getElementById("fuel").value,
      type:document.getElementById("type").value
    });

    save();
    display();

    this.reset();
  }
);

function deleteRecord(index){

  if(confirm("دڵنیایت لە سڕینەوەی ئەم تۆمارە؟")){

    records.splice(index,1);

    save();
    display();
  }
}

display();

</script>

</body>
</html>
